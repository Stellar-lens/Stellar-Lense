# Root-level .dockerignore — used by apps/api/Dockerfile, which builds
# from the repo root (it needs the shared uv workspace lockfile; see the
# comment at the top of apps/api/Dockerfile). Keeps the build context small
# by excluding everything not actually COPYed into that image; add
# exclusions here for any other service that later builds from the root
# the same way.

.git/
node_modules/
**/node_modules/

# Python virtualenvs and caches, wherever they live in the monorepo.
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/

# packages/core is copied in (apps/api imports it); only its tests are excluded.
packages/core/tests/

# Not needed to build/run apps/api.
apps/web/
contracts/
docs/
*.md
!packages/core/README.md

.DS_Store
