.hypothesis/

# Mutation testing
.mutmut-cache
mutmut-results/

# Fuzz corpus (generated at runtime — keep only hand-crafted seeds in VCS)
tests/fuzz/corpus/generated/

# Profiling output
*.prof
*.lprof
profiling/

# Trained model artefacts (binary, large)
models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx
models/archive/
models/optuna_studies.db
models/best_params_*.json
models/conformal_calibration.joblib

# Generated / runtime reports (keep committed sample reports)
reports/load_test_results.json
reports/forensic/
reports/backtest_*.json
reports/poisoning_alert_*.json

# Watermark store (runtime state, not source)
data/watermarks.json

# Generated dataset outputs (large binary, reproducible)
data/*.parquet
data/*.csv
# Keep committed reference files
!data/synthetic_dataset.parquet
!data/known_manipulation_events.csv
!data/feature_ranges.json
!data/build_config.json

# Annotation queue (runtime state)
data/annotation_queue.json

