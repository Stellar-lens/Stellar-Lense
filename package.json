{
  "name": "ledgerlens-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static web dashboard for LedgerLens — Stellar DEX wash-trade risk scores, alerts, and asset rankings.",
  "scripts": {
    "serve": "python3 -m http.server 8080 --directory dashboard",
    "lint": "eslint dashboard/js tests",
    "lint:css": "stylelint \"dashboard/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
