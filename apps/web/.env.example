# Environment variables for apps/web. Copy to `.env.local` for local dev;
# on Vercel, set these under Project Settings > Environment Variables
# (Production/Preview/Development as appropriate) — do not commit real
# values to this file or anywhere else in the repo.
#
# This list is exhaustive: `grep -rn "process\.env\." src` finds exactly
# the two variables below. Anything not listed here isn't read by this app.

# --- Public (exposed to the browser bundle at build time) ---------------

# Base URL for apps/api (see apps/api/api/schemas.py for the API this app
# consumes). Defaults to http://localhost:8000 if unset, which only works
# for local dev against a locally-running apps/api. In a real deployment,
# set this to wherever apps/api is actually deployed (it has no Vercel
# config of its own yet — it's a separate FastAPI service, not part of
# this Next.js app).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Server-only (never sent to the browser) -----------------------------

# CryptoPanic API token (free tier is enough for read-only news polling).
# Get one at https://cryptopanic.com/developers/api/ — sign up, then find
# your token under Account > API. Server-only: no NEXT_PUBLIC_ prefix, so
# it's never sent to the browser (read only in src/lib/news.ts, via the
# proxy route at src/app/api/news/route.ts). If unset, the CryptoPanic
# half of the news feed is skipped with a warning rather than failing the
# whole page — see getNewsFeed in src/lib/news.ts.
CRYPTOPANIC_API_TOKEN=

# No CoinDesk key needed. The secondary source (plan §4.3) is CoinDesk's
# public RSS feed (https://www.coindesk.com/arc/outboundfeeds/rss/), which
# doesn't require authentication. If you have access to a real CoinDesk
# news/data API product beyond what RSS covers, it can be added here later
# — see the note in src/lib/news.ts's file comment.
