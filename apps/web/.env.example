# CryptoPanic API token (free tier is enough for read-only news polling).
# Get one at https://cryptopanic.com/developers/api/ — sign up, then find
# your token under Account > API. Server-only: no NEXT_PUBLIC_ prefix, so
# it's never sent to the browser (read only in src/lib/news.ts, via the
# proxy route at src/app/api/news/route.ts).
CRYPTOPANIC_API_TOKEN=

# No CoinDesk key needed. The secondary source (plan §4.3) is CoinDesk's
# public RSS feed (https://www.coindesk.com/arc/outboundfeeds/rss/), which
# doesn't require authentication. If you have access to a real CoinDesk
# news/data API product beyond what RSS covers, it can be added here later
# — see the note in src/lib/news.ts's file comment.

# Base URL for apps/api. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
