# Environment variables for apps/api. Copy to `.env` for local dev (uvicorn
# doesn't load .env files itself — export these, or use `uv run --env-file
# .env uvicorn api.main:app --reload`); on your container host, set these
# under its environment-variables/secrets settings, not in this file.
#
# This list is exhaustive for what this service actually reads today —
# confirmed against api/config.py, the only module that touches
# os.environ. See the notes below for things you might expect here but
# won't find, and why.

# --- CORS -----------------------------------------------------------------

# Comma-separated list of origins allowed to call this API from a browser —
# i.e. wherever apps/web is actually deployed (its Vercel production domain,
# and any preview-deployment domains you want to allow). Falls back to the
# local Next.js dev server origins (http://localhost:3000,
# http://127.0.0.1:3000) if unset — see api/config.py:cors_allowed_origins.
#
# Example for a real deployment:
#   CORS_ALLOWED_ORIGINS=https://stellar-lense.vercel.app,https://stellar-lense-git-main-yourorg.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Provided by the platform, not set by you ------------------------------

# Railway/Fly/Render inject PORT themselves; the Dockerfile's CMD reads it
# (${PORT:-8000}) and there's nothing to configure here. Listed only so
# it's not mistaken for something missing from this file.
# PORT=8000

# --- Not used by this service (listed so you don't go looking) ------------

# No CryptoPanic or CoinDesk API keys here — this service never calls
# either. That's apps/web's job (its own Next.js API route proxies
# CryptoPanic/CoinDesk server-side so the token never reaches the browser)
# — see apps/web/.env.example for CRYPTOPANIC_API_TOKEN.
#
# No DATABASE_URL — this service has no database. api/storage.py is an
# in-memory demo data store (seeded synthetic trades, including a
# synthetic wash-trading pattern), standing in for the real data layer
# that packages/core/detection/storage.py reads from (a live ingestion
# pipeline writing to a persisted risk_scores table) but that isn't wired
# into this API yet. If/when it is, its connection string belongs here.
